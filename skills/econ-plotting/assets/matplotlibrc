## AEJ-style matplotlib defaults
## mirrors set_aej() in skills/notebook-setup/ — keep in sync

font.family         : serif
font.style          : italic
font.size           : 15

figure.dpi          : 150
figure.facecolor    : EAF1F2
axes.facecolor      : EAF1F2

axes.linewidth      : 1.0
lines.linewidth      : 1.2

axes.spines.top      : False
axes.spines.right    : False
axes.spines.left     : False
axes.spines.bottom   : False

text.color           : 3F6469
axes.labelcolor      : 3F6469
xtick.color          : 3F6469
ytick.color          : 3F6469

xtick.direction     : out
ytick.direction     : out

legend.frameon          : False
legend.fancybox         : False
legend.borderaxespad    : 0.4
legend.handlelength     : 2.0
legend.handletextpad    : 0.6
legend.labelspacing     : 0.35

savefig.bbox        : tight
savefig.dpi         : 300
